{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "academy.html", "use": "@vercel/static" },
    { "src": "login.html", "use": "@vercel/static" },
    { "src": "academy-live.html", "use": "@vercel/static" },
    { "src": "academy-apply.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "student-preview.html", "use": "@vercel/static" },
    { "src": "masterclass-join.html", "use": "@vercel/static" },
    { "src": "masterclass/join/index.html", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "mobile-polish.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "assistara-logo.svg", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/mobile-polish.css", "dest": "/mobile-polish.css" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/assistara-logo.svg", "dest": "/assistara-logo.svg" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/masterclass/join", "dest": "/masterclass/join/index.html" },
    { "src": "/masterclass/join/", "dest": "/masterclass/join/index.html" },
    { "src": "/masterclass-join.html", "dest": "/masterclass-join.html" },
    { "src": "/academy-apply.html", "dest": "/academy-apply.html" },
    { "src": "/academy/apply", "dest": "/academy-apply.html" },
    { "src": "/academy/apply/", "dest": "/academy-apply.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/admin/", "dest": "/admin.html" },
    { "src": "/academy/test-portal", "dest": "/student-preview.html" },
    { "src": "/academy/test-portal/", "dest": "/student-preview.html" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/login.html", "dest": "/login.html" },
    { "src": "/academy", "dest": "/academy-live.html" },
    { "src": "/academy.html", "dest": "/academy.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}
